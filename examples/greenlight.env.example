# greenlight.env.example — every runner setting, with its default.
#
# Copy to <greenlight dir>/greenlight.env (loaded automatically, gitignored via *.env) or to
# any path and pass it with `--env <file>` / GREENLIGHT_ENV=<file>. Precedence: command-line
# flags > shell environment > this file. Paths default relative to the directory that contains
# greenlight.sh, so the runner works from any cwd.

# ---------------------------------------------------------------- target repo
REPO_DIR=                       # REQUIRED. Absolute path to the checkout the agents work in.
BASE_BRANCH=main                # branch every task starts from and every PR targets

# ---------------------------------------------------------------- runner files
#QUEUE_FILE=./queue.txt          # or pass the queue as the first positional argument
#PROMPTS_DIR=./prompts           # prompts/<TASK>.md, one per task-id
#STATE_DIR=./state               # done.txt, prs.txt, runner.pid
#LOGS_DIR=./logs
#SETTINGS_FILE=./claude-settings.json   # falls back to examples/claude-settings.example.json

# ---------------------------------------------------------------- headless session
#CLAUDE_BIN=claude
#CLAUDE_PERMISSION_MODE=acceptEdits
#CLAUDE_EXTRA_ARGS=              # appended verbatim, e.g. "--model claude-opus-5"
#TASK_TIMEOUT_S=3600             # per task session (perl alarm; exit 142 on timeout)

# ---------------------------------------------------------------- environment sync
# Runs in $REPO_DIR after the base branch is clean, before every task. Must not modify versioned
# files (the tree is re-checked). Empty = skipped.
#SYNC_COMMAND=

# ---------------------------------------------------------------- CI gate (see lib/checks.sh)
CHECKS_MODE=count               # count | names | list
MIN_CHECKS=1                    # count mode only; warns on every gate
#CHECKS_SOURCE=                  # names mode: file inside the target repo (relative to REPO_DIR)
#CHECKS_JQ_FILTER=               # names mode: jq program run with `jq -rRs`; one name per line
#REQUIRED_CHECKS=                # list mode: "build,lint,e2e"
#CHECKS_APPEAR_TRIES=20          # × CHECKS_APPEAR_SLEEP_S waiting for check-runs to exist
#CHECKS_APPEAR_SLEEP_S=15

# ---------------------------------------------------------------- babysit (optional)
# Runs once per PR in $REPO_DIR, after the first green gate, with PR_NUMBER, TASK_ID, REPO_DIR,
# BASE_BRANCH, SETTINGS_FILE and GREENLIGHT_DIR exported. It may push to the PR branch (the gate
# re-runs on the new head); it must leave the tree clean. Empty = skipped with a log line.
# Contract: exit with a clean tree; optionally print DEFERRED_FINDINGS=<n> (docs/prompt-contract.md).
#BABYSIT_COMMAND=
#BABYSIT_DELAY_S=0               # sleep between the green gate and the babysit (late review bots)
#BABYSIT_TIMEOUT_S=1800
#SKIP_BABYSIT=0

# ---------------------------------------------------------------- merge polling
#POLL_INTERVAL=60
#POLL_FAILS_WARN=3
#POLL_FAILS_ABORT=5
#HEARTBEAT_EVERY_POLLS=10

# ---------------------------------------------------------------- integrations
#GH_BIN=gh                       # path to a single executable (no arguments): a pinned gh, or a test wrapper
#ORCA_ENABLED=1                  # off by default; 1 enables Orca ADE worktree-card reporting (needs the orca CLI)
#ORCA_SELECTOR=                  # default: path:$REPO_DIR

# ================================================================ full example
# A monorepo with two packages, a generated ORM client, required checks declared in a workflow
# file, and a review agent run once per PR. Uncomment and adapt.
#
# REPO_DIR=/path/to/checkouts/my-project
# BASE_BRANCH=main
# SYNC_COMMAND='pnpm install --frozen-lockfile --silent && (cd api && pnpm exec prisma generate)'
#
# CHECKS_MODE=names
# CHECKS_SOURCE=.github/workflows/merge-ready.yml
# # the workflow has a line:   REQUIRED_CHECKS: "build, lint, unit, e2e"
# CHECKS_JQ_FILTER='capture("REQUIRED_CHECKS:[[:space:]]*\"(?<v>[^\"]*)\"").v | split(",")[]'
#
# # or, for a JSON source such as .github/required-checks.json = {"required": ["build","lint"]}
# # CHECKS_JQ_FILTER='fromjson | .required[]'
#
# # or simply:
# # CHECKS_MODE=list
# # REQUIRED_CHECKS="build,lint,unit,e2e"
#
# BABYSIT_COMMAND='claude -p "Review PR #$PR_NUMBER in this repo: fix red CI, apply objective review comments, push, and reply on the threads. Leave the working tree clean." --settings "$SETTINGS_FILE" --permission-mode acceptEdits --output-format json'
# BABYSIT_TIMEOUT_S=1800
# POLL_INTERVAL=60
